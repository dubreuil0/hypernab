{
  "manifest_version": 3,
  "name": "Hypernab — Video Yakalayıcı",
  "description": "Oynatılan DRM’siz video dosyalarını ve HLS/DASH isteklerini yerel indirme yöneticisine gönderir.",
  "version": "0.6.2",
  "permissions": ["webRequest", "storage", "activeTab", "nativeMessaging", "cookies", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["native-config.js", "native.js", "core.js", "background.js", "float.js", "takeover.js"] },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "browser_specific_settings": {
    "gecko": { "id": "hypernab@local.invalid", "strict_min_version": "128.0" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Bu sayfadaki videolar", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } }
}
